{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name becomes its address: genesis-network.<account>.workers.dev
  "name": "genesis-network",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Workers Cache: pages are served from Cloudflare's edge without running the
  // Worker. vinext's build splits this into per-entrypoint settings.
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genesis-network",
      // Placeholder until `wrangler d1 create genesis-network` returns the real
      // id. Local development runs against a local copy and ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
