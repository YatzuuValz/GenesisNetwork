{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "db:admin": "node scripts/create-admin.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "1.0.0-beta.10",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "type": "module",
  "imports": {
    "#db-driver": {
      "workerd": "./src/server/db-driver.d1.ts",
      "default": "./src/server/db-driver.libsql.ts"
    }
  }
}
